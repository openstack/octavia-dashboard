msgid "%(ip)s..."
msgstr "%(ip)s..."

msgid ""
"<strong>App Cookie</strong>: Session persistence based on application cookie."
msgstr ""
"<strong>Cookie приложения</strong>: привязка сессии на основе cookie "
"приложения."

msgid "<strong>Contains</strong>: String contains."
msgstr ""
"<strong>Содержит</strong>: проверяет, содержит ли строка указанное значение."

msgid ""
"<strong>Cookie</strong>: The rule looks for a cookie named by the key "
"parameter and\n"
"      compares it against the value parameter in the rule."
msgstr ""
"<strong>Cookie</strong>: правило ищет cookie с именем, заданным в поле "
"\"Ключ\", и сравнивает его со значением, указанным в поле \"Значение\"."

msgid "<strong>Ends With</strong>: String ends with."
msgstr ""
"<strong>Заканчивается на</strong>: проверяет, заканчивается ли строка "
"указанным значением."

msgid "<strong>Equal To</strong>: String is equal to."
msgstr ""
"<strong>Равно</strong>: проверяет, совпадает ли строка с указанным значением."

msgid ""
"<strong>File Type</strong>: The rule compares the last portion of the URI "
"against\n"
"      the value parameter in the rule. (eg. \"txt\", \"jpg\", etc.)"
msgstr ""
"<strong>Тип файла</strong>: правило проверяет, соответствует ли расширение "
"файла в URI значению из поля \"Значение\" (например, \"txt, \"jpg\" и т. д.)."

msgid "<strong>HTTP Cookie</strong>: Session persistence based on HTTP cookie."
msgstr "<strong>HTTP Cookie</strong>: привязка сессии на основе HTTP-cookie."

msgid ""
"<strong>Header</strong>: The rule looks for a header defined in the key "
"parameter\n"
"      and compares it against the value parameter in the rule."
msgstr ""
"<strong>Заголовок</strong>: правило проверяет значение заголовка, имя "
"которого указано в поле \"Ключ\", на соответствие значению из поля "
"\"Значение\"."

msgid ""
"<strong>Host Name</strong>: The rule does a comparison between the HTTP/1.1\n"
"      hostname in the request against the value parameter in the rule."
msgstr ""
"<strong>Имя хоста</strong>: правило сравнивает имя хоста из HTTP/1.1-запроса "
"со значением параметра в этом правиле."

msgid ""
"<strong>Least Connections</strong>: Allocates requests to the instance with "
"the least number of active\n"
"      connections."
msgstr ""
"<strong>Least Connections</strong>: запросы направляются на инстанс с "
"наименьшим количеством активных соединений."

msgid ""
"<strong>Path</strong>: The rule compares the path portion of the HTTP URI "
"against\n"
"      the value parameter in the rule."
msgstr ""
"<strong>Путь</strong>: правило проверяет, соответствует ли путь в HTTP URI "
"значению из поля \"Значение\"."

msgid ""
"<strong>Redirect To Pool</strong>: The request is forwarded to the back-end "
"pool associated with the L7 policy."
msgstr ""
"<strong>Перенаправить в пул</strong>: запрос направляется во внутренний пул, "
"связанный с данной политикой L7."

msgid ""
"<strong>Redirect To URL</strong>: The request is sent an HTTP redirect to "
"the URL defined in the \"Redirect URL\" parameter."
msgstr ""
"<strong>Перенаправление на URL</strong>: запрос перенаправляется по HTTP на "
"URL, указанный в поле \"URL перенаправления\"."

msgid "<strong>Regex</strong>: Perl type regular expression matching."
msgstr ""
"<strong>Регулярное выражение</strong>: сопоставление с использованием "
"регулярного выражения в стиле Perl."

msgid ""
"<strong>Reject</strong>: The request is denied with an appropriate response "
"code, and not forwarded on to any back-end pool."
msgstr ""
"<strong>Отклонить</strong>: запрос отклоняется с соответствующим кодом "
"ответа и не перенаправляется ни в один из внутренних пулов."

msgid ""
"<strong>Round Robin</strong>: Rotates requests evenly between multiple "
"instances."
msgstr ""
"<strong>Round Robin</strong>: запросы равномерно распределяются между "
"несколькими инстансами."

msgid ""
"<strong>Source IP:Port</strong>: Requests from a unique source IP address "
"and port pair are consistently directed to the same instance."
msgstr ""
"<strong>Исходный IP:Порт</strong>: запросы от одной и той же пары \"исходный "
"IP: порт\" всегда направляются на один и тот же инстанс."

msgid ""
"<strong>Source IP</strong>: Requests from a unique source IP address are "
"consistently directed to the same instance."
msgstr ""
"<strong>Исходный IP</strong>: запросы от одного и того же исходного IP-"
"адреса всегда направляются на один и тот же инстанс."

msgid "<strong>Source IP</strong>: Session persistence based on source IP."
msgstr ""
"<strong>Исходный IP</strong>: привязка сессии на основе исходного IP-адреса."

msgid "<strong>Starts With</strong>: String starts with."
msgstr ""
"<strong>Начинается с</strong>: проверяет, начинается ли строка с указанного "
"значения."

